{
  "name": "react-prac",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:ecomm": "pnpm --filter e-comm dev",
    "dev:api_v2": "pnpm --filter api_v2 dev",
    "dev:angular-ecomm": "pnpm --filter angular-ecomm dev",
    "build": "turbo run build",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "dependencies": {
    "react-icons": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "esbuild"
    ]
  }
}
